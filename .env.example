# --- Audiobookshelf ---
# URL as reachable from this container (service name on the shared Docker network).
ABS_URL=http://audiobookshelf:80
# ABS -> Settings -> Users -> (your admin user) -> API token
ABS_TOKEN=
# Optional comma-separated library ids; empty = every book library
ABS_LIBRARY_IDS=

# --- Shelfmark ---
SHELFMARK_URL=http://shelfmark:8084
# Must equal SHELFMARK_API_KEY set on the Shelfmark container (openssl rand -base64 32)
SHELFMARK_API_KEY=
# Optional: where Shelfmark's /books folder is mounted in THIS container. Leave empty to
# download finished files over HTTP (/api/localdownload) instead.
SHELFMARK_BOOKS_DIR=

# --- Paths ---
# "path-inside-ABS-container:path-inside-this-container", comma-separated for several.
# ABS reports item folders using its own container paths; this translates them.
# If Shelfmark's folder is mounted, add a mapping for it too, e.g. ",/books:/shelfmark-books"
PATH_MAP=/audiobooks:/library

# --- Behaviour ---
MIN_SCORE=0
MAX_CANDIDATES=8
# Seconds to wait for a release search (Shelfmark's own limit is release_search_timeout, default 300)
SEARCH_TIMEOUT=330
# Max release searches at once. Keep at 1: Anna's Archive rate-limits (429) parallel searches.
SEARCH_CONCURRENCY=1
# Saved search results (incl. pre-search) are reused for this many hours
SEARCH_CACHE_HOURS=24
# Pre-search: seconds to pause between books, and the default number of books offered in the web UI
PRESEARCH_DELAY=5
PRESEARCH_COUNT=100

# --- Downloads ---
# Books downloading at once. Set Shelfmark's own MAX_CONCURRENT_DOWNLOADS at least this high.
# (Replaces WORKER_CONCURRENCY - remove that line from older .env files, it overrides this.)
DOWNLOAD_CONCURRENCY=3
# Anna's Archive (Direct Download) rate-limits hard: keep these to 1 at a time. Torrents/usenet run in parallel.
DIRECT_DOWNLOAD_CONCURRENCY=1
# DOWNLOAD_TIMEOUT only counts while Shelfmark is working on a book; QUEUE_WAIT_TIMEOUT caps time
# spent waiting in Shelfmark's queue first.
DOWNLOAD_TIMEOUT=600
QUEUE_WAIT_TIMEOUT=3600
# Re-queue a download that failed on a rate limit (after the cooldown) up to this many times
RATE_LIMIT_RETRIES=2
# "Auto-retry failed downloads" switch (Activity page): how often it re-queues every failed download
AUTO_RETRY_MINUTES=60
# Seconds a running download tolerates Shelfmark being unreachable before failing (use Pause for longer)
SHELFMARK_GRACE=120
# Times a download is re-sent if Shelfmark lost it (a restart empties Shelfmark's in-memory queue)
LOST_TASK_RESENDS=2

# --- NAS share (only if docker-compose.yml mounts the library over SMB/CIFS) ---
SMB_USERNAME=
SMB_PASSWORD=

# --- Web UI ---
WEB_USER=admin
WEB_PASSWORD=
WEB_PORT=8090
